<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" alignment="CENTER" style="-fx-padding: 30; -fx-background-color: #f8f9fa;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="app.controller.FormViewController">
    <children>
        <Label text="Cadastrar Nova Transação" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
        
        <GridPane hgap="15" vgap="15" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints minWidth="80" prefWidth="100" halignment="RIGHT"/>
                <ColumnConstraints minWidth="200" prefWidth="250" hgrow="ALWAYS"/>
            </columnConstraints>
            <children>
                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-size: 14px;"/>
                <ComboBox fx:id="cmbType" prefWidth="250.0" promptText="Selecione..." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Categoria:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 14px;"/>
                <TextField fx:id="txtCategory" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="Valor:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 14px;"/>
                <TextField fx:id="txtAmount" prefWidth="250.0" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-size: 14px;"/>
                <DatePicker fx:id="txtDate" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </children>
        </GridPane>
        
        <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 10 0 0 0;">
            <children>
                <Button text="Cancelar" onAction="#handleCancel" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15;"/>
                <Button text="Salvar Registro" onAction="#handleSave" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 15;"/>
            </children>
        </HBox>
    </children>
</VBox>
